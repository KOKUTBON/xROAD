# ==============================================================================
# xROAD / Road Accidents Risk Modeling - Environment Configuration Template
# ==============================================================================
# Copy this file to `.env` in the repository root or provide these variables in
# your execution environment. Never commit `.env` or real credentials to Git.
#
# For local containerized setup, see `infra/docker/.env.example`.
# For staging and production deployments, see `infra/k8s/environments/`.
# ==============================================================================

# --- Application & Runtime Environment ----------------------------------------
# Environment mode: 'local', 'staging', or 'production'
ROAD_RISK_API_ENV=local
ROAD_RISK_ENVIRONMENT=local
ROAD_RISK_BUILD_SHA=local-dev

# --- Database & Storage -------------------------------------------------------
# PostgreSQL / PostGIS connection string.
# Example: postgresql+psycopg://<username>:<password>@<host>:<port>/<database>
ROAD_RISK_DATABASE_URL=postgresql+psycopg://postgres:postgres@localhost:5432/road_risk

# S3-compatible object storage (MinIO locally, AWS S3 in cloud deployments).
# Example MinIO endpoint: http://localhost:9000
# Example AWS S3: leave endpoint unset and provide region + credentials
ROAD_RISK_STORAGE_ENDPOINT_URL=http://localhost:9000
ROAD_RISK_STORAGE_REGION=us-east-1
ROAD_RISK_STORAGE_ACCESS_KEY_ID=minioadmin
ROAD_RISK_STORAGE_SECRET_ACCESS_KEY=minioadmin
ROAD_RISK_STORAGE_BUCKET=road-risk
ROAD_RISK_STORAGE_USE_SSL=false
ROAD_RISK_STORAGE_VERIFY_SSL=false
ROAD_RISK_STORAGE_AUTO_CREATE_BUCKETS=true

# --- Redis & Background Workers -----------------------------------------------
# Redis connection string used by Celery task workers and Beat scheduler.
ROAD_RISK_REDIS_URL=redis://localhost:6379/0
CELERY_BROKER_URL=redis://localhost:6379/0
CELERY_RESULT_BACKEND=redis://localhost:6379/0

# --- API Security & Authentication --------------------------------------------
# Authentication toggle: set to true in production deployments.
ROAD_RISK_API_AUTH_ENABLED=false
ROAD_RISK_API_AUTH_PROVIDER=keycloak

# OIDC / JWKS settings (required when ROAD_RISK_API_AUTH_ENABLED=true)
ROAD_RISK_API_AUTH_JWKS_URL=
ROAD_RISK_API_AUTH_ISSUER=
ROAD_RISK_API_AUTH_AUDIENCE=
ROAD_RISK_API_AUTH_CLIENT_ID=

# Rate limiting controls
ROAD_RISK_API_RATE_LIMIT_ENABLED=false
ROAD_RISK_API_RATE_LIMIT_REQUESTS=120
ROAD_RISK_API_RATE_LIMIT_WINDOW_SECONDS=60

# CORS settings for API
ROAD_RISK_API_CORS_ALLOWED_ORIGINS=http://localhost:3000,http://127.0.0.1:3000

# --- Web Frontend Settings ----------------------------------------------------
# Target API URL for Next.js frontend proxy
ROAD_RISK_WEB_API_BASE_URL=http://localhost:8000
NEXT_PUBLIC_API_BASE_URL=http://localhost:8000

# Web OIDC authentication configuration (for production Keycloak or compatible IdP)
ROAD_RISK_WEB_OIDC_ISSUER=
ROAD_RISK_WEB_OIDC_CLIENT_ID=
ROAD_RISK_WEB_OIDC_CLIENT_SECRET=

# Development demo role-switcher (strictly disabled in production builds)
NEXT_PUBLIC_ENABLE_DEMO_AUTH=false

# --- Error Tracking & Observability (Optional) --------------------------------
ROAD_RISK_API_ERROR_TRACKING_ENABLED=false
ROAD_RISK_API_SENTRY_DSN=
ROAD_RISK_API_SENTRY_ENVIRONMENT=local
ROAD_RISK_API_SENTRY_TRACES_SAMPLE_RATE=0.0
