# Example environment file for `infra/docker/docker-compose.yml`.
# Copy this file to `infra/docker/.env` before running `docker compose up`.
# Tracked by: https://github.com/KOKUTBON/xROAD/issues/85

# --- Host port bindings ------------------------------------------------------
API_HOST_PORT=8000
WEB_HOST_PORT=3000
POSTGRES_HOST_PORT=5432
REDIS_HOST_PORT=6379
MINIO_API_HOST_PORT=9000
MINIO_CONSOLE_HOST_PORT=9001

# --- Postgres / PostGIS ------------------------------------------------------
POSTGRES_USER=postgres
POSTGRES_PASSWORD=postgres
POSTGRES_DB=road_risk

# --- MinIO ------------------------------------------------------------------
MINIO_ROOT_USER=minioadmin
MINIO_ROOT_PASSWORD=minioadmin
ROAD_RISK_STORAGE_BUCKET=road-risk

# --- API runtime toggles ----------------------------------------------------
# Auth stays off in local mode by default; enable when running with a real
# Keycloak (or compatible) OIDC realm.
ROAD_RISK_API_AUTH_ENABLED=false

# --- Web runtime ------------------------------------------------------------
NEXT_PUBLIC_API_BASE_URL=http://localhost:8000
