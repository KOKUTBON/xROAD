# ==============================================================================
# xROAD Institutional White-Label Production Environment Template
# ==============================================================================
# Use this file to configure an institutional deployment for a national Ministry
# of Transport, regional transport authority, police department, or city agency.
# Copy to `infra/docker/.env.institution` before running `docker compose`.
# ==============================================================================

# --- Public HTTPS entry point -------------------------------------------------
# Required: actual institution hostname, without scheme, port, or path.
ROAD_RISK_HOSTNAME=
ROAD_RISK_DEPLOYMENT_NAME=road-risk-institution-example
ROAD_RISK_INSTITUTION_DATA_DIR=./institution-data/example
ROAD_RISK_INSTITUTION_BRAND_DIR=./institution-data/example/brand
HTTPS_HOST_PORT=443
# Paths below are relative to infra/docker/ (the Compose file directory).
ROAD_RISK_TLS_CERTIFICATE_FILE=./secrets/institution/tls_certificate
ROAD_RISK_TLS_PRIVATE_KEY_FILE=./secrets/institution/tls_private_key

# --- Institutional White-Label Branding ---------------------------------------
ROAD_RISK_API_TENANT_ID=cerema_fr
ROAD_RISK_API_INSTITUTION_NAME="Centre d'études et d'expertise sur les risques, la mobilité et l'aménagement (Cerema)"
ROAD_RISK_API_BRAND_NAME="SécurRoute France"
ROAD_RISK_API_BRAND_PRIMARY_COLOR="#0055A5"
ROAD_RISK_API_BRAND_LOGO_URL="/brand/road-accidents-risk-modeling-icon.svg"
ROAD_RISK_API_PORTAL_SUBTITLE="Plateforme institutionnelle d'analyse prédictive des risques routiers"
ROAD_RISK_API_TENANT_CONFIG_PATH=/app/configs/institutional_tenant.example.toml

# --- Sovereign Localization & Driving Conventions -----------------------------
ROAD_RISK_API_COUNTRY_CODE=FR
ROAD_RISK_API_DEFAULT_LANGUAGE=fr
ROAD_RISK_API_DRIVING_SIDE=right
ROAD_RISK_API_DISTANCE_UNIT=km
ROAD_RISK_API_SPEED_UNIT=km/h
ROAD_RISK_API_CURRENCY=EUR
ROAD_RISK_API_ADMINISTRATIVE_TIER=country

# --- Relational Database (PostgreSQL 16 + PostGIS 3.4) -----------------------
POSTGRES_USER=roadrisk_admin
POSTGRES_PASSWORD_FILE=./secrets/institution/postgres_password
POSTGRES_DB=road_risk_production

# --- Object Storage (MinIO / S3 Sovereign Cloud) ------------------------------
MINIO_ROOT_USER=storage_admin
MINIO_ROOT_PASSWORD_FILE=./secrets/institution/minio_password
ROAD_RISK_STORAGE_BUCKET=road-risk-artifacts
ROAD_RISK_STORAGE_USE_SSL=false
ROAD_RISK_STORAGE_AUTO_CREATE_BUCKETS=true

# --- Institutional Authentication (OIDC / Keycloak / Gov SSO) -----------------
# Authentication is mandatory in the institutional stack. Fill these values.
ROAD_RISK_API_AUTH_ENABLED=true
ROAD_RISK_API_AUTH_PROVIDER=keycloak
ROAD_RISK_API_AUTH_JWKS_URL=
ROAD_RISK_API_AUTH_ISSUER=
ROAD_RISK_API_AUTH_AUDIENCE=
ROAD_RISK_API_AUTH_CLIENT_ID=

# --- Web Frontend Runtime -----------------------------------------------------
# Browser traffic uses the same HTTPS origin via /api/backend.
ROAD_RISK_WEB_OIDC_CLIENT_ID=
ROAD_RISK_WEB_OIDC_CLIENT_SECRET_FILE=./secrets/institution/oidc_client_secret
# Optional endpoints for providers other than Keycloak.
ROAD_RISK_WEB_OIDC_AUTHORIZATION_ENDPOINT=
ROAD_RISK_WEB_OIDC_TOKEN_ENDPOINT=
ROAD_RISK_WEB_OIDC_LOGOUT_ENDPOINT=
NEXT_TELEMETRY_DISABLED=1
