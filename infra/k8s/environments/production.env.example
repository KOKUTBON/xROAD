# Sample values for the production namespace. Real values must be
# reviewed by the deployment owner and security owner before use.

ROAD_RISK_ENVIRONMENT=production
ROAD_RISK_NAMESPACE=road-risk-production
ROAD_RISK_WEB_HOST=road-risk.example.gov
ROAD_RISK_API_HOST=api.road-risk.example.gov
ROAD_RISK_TLS_ISSUER=letsencrypt-production

ROAD_RISK_IMAGE_REGISTRY=registry.example.gov/road-risk
ROAD_RISK_IMAGE_TAG=1.0.0
ROAD_RISK_API_IMAGE=registry.example.gov/road-risk/api:1.0.0
ROAD_RISK_WORKER_IMAGE=registry.example.gov/road-risk/worker:1.0.0
ROAD_RISK_WEB_IMAGE=registry.example.gov/road-risk/web:1.0.0

ROAD_RISK_API_ENV=production
ROAD_RISK_STORAGE_BUCKET=road-risk-production
ROAD_RISK_STORAGE_PUBLIC_BUCKET=road-risk-public-production
ROAD_RISK_WEB_API_BASE_URL=http://road-risk-api.road-risk-production.svc.cluster.local
NEXT_PUBLIC_API_BASE_URL=

ROAD_RISK_OIDC_ISSUER=https://auth.road-risk.example.gov/realms/road-risk
