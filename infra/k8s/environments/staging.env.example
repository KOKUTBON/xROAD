# Sample values for a remote staging namespace.
# These values are documentation and release-runner inputs; do not source
# them into shells that log environment variables because some commands
# may expand private hosts or registry paths.

ROAD_RISK_ENVIRONMENT=staging
ROAD_RISK_NAMESPACE=road-risk-staging
ROAD_RISK_WEB_HOST=staging.road-risk.example.gov
ROAD_RISK_API_HOST=api.staging.road-risk.example.gov
ROAD_RISK_TLS_ISSUER=letsencrypt-staging

ROAD_RISK_IMAGE_REGISTRY=registry.example.gov/road-risk
ROAD_RISK_IMAGE_TAG=2026.06.04-rc.1
ROAD_RISK_API_IMAGE=registry.example.gov/road-risk/api:2026.06.04-rc.1
ROAD_RISK_WORKER_IMAGE=registry.example.gov/road-risk/worker:2026.06.04-rc.1
ROAD_RISK_WEB_IMAGE=registry.example.gov/road-risk/web:2026.06.04-rc.1

ROAD_RISK_API_ENV=staging
ROAD_RISK_STORAGE_BUCKET=road-risk-staging
ROAD_RISK_STORAGE_PUBLIC_BUCKET=road-risk-public-staging
ROAD_RISK_WEB_API_BASE_URL=http://road-risk-api.road-risk-staging.svc.cluster.local
NEXT_PUBLIC_API_BASE_URL=

ROAD_RISK_OIDC_ISSUER=https://auth.staging.road-risk.example.gov/realms/road-risk
ROAD_RISK_WEB_OIDC_REDIRECT_URI=https://staging.road-risk.example.gov/api/auth/callback

SMOKE_API_BASE_URL=https://api.staging.road-risk.example.gov
SMOKE_WEB_BASE_URL=https://staging.road-risk.example.gov
SMOKE_CITY_KEY=bari
