# Local production-like staging environment for issue #118.
# This file intentionally uses non-default host ports so it can be run
# without colliding with the normal local-dev examples.

API_HOST_PORT=18000
WEB_HOST_PORT=13000
POSTGRES_HOST_PORT=15432
REDIS_HOST_PORT=16379
MINIO_API_HOST_PORT=19000
MINIO_CONSOLE_HOST_PORT=19001

POSTGRES_USER=postgres
POSTGRES_PASSWORD=postgres
POSTGRES_DB=road_risk_staging

MINIO_ROOT_USER=minioadmin
MINIO_ROOT_PASSWORD=minioadmin
ROAD_RISK_STORAGE_BUCKET=road-risk-staging

ROAD_RISK_API_ENV=staging-local
ROAD_RISK_API_AUTH_ENABLED=false
ROAD_RISK_BUILD_SHA=local-staging
ROAD_RISK_BUILD_REF=issue-118
ROAD_RISK_BUILD_TIMESTAMP=2026-05-26T00:00:00Z

NEXT_PUBLIC_API_BASE_URL=http://localhost:18000

STAGING_ORGANIZATION_ID=00000000-0000-0000-0000-000000000118
STAGING_CITY_KEY=bari
